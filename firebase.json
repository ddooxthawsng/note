{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "backend",
      "runtime": "python311",
      "codebase": "default",
      "ignore": ["venv", "__pycache__", ".git", "*.pyc"]
    }
  ],
  "hosting": {
    "site": "thangdo-note",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "tool", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
