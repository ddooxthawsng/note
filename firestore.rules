rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Notes rules (support public sharing and multi-account collaboration)
    match /notes/{noteId} {
      allow read: if isOwner(resource.data.userId)
                  || (resource.data.isShared == true)
                  || isCollaborator(resource.data)
                  || isAdmin();
      allow delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(resource.data.userId) || isCollaborator(resource.data))
                    && request.resource.data.userId == resource.data.userId;
    }

    // Tasks rules
    match /tasks/{taskId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    // Folders rules (support multi-account sharing)
    match /folders/{folderId} {
      allow read: if isOwner(resource.data.userId)
                  || isCollaborator(resource.data)
                  || isAdmin();
      allow delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(resource.data.userId) || isCollaborator(resource.data))
                    && request.resource.data.userId == resource.data.userId;
    }

    // User profile docs with roles & status.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         (!('role' in resource.data) || request.resource.data.role == resource.data.role) && 
         (!('status' in resource.data) || request.resource.data.status == resource.data.status)) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Shared app configuration (Telegram & Gemini keys configured by Admin, used by all accounts).
    match /appConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Telegram Drive manifests. Bot tokens and file bytes are never stored here.
    match /telegramFiles/{fileId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    // Telegram Drive folder metadata. File bytes remain in Telegram.
    match /telegramFolders/{folderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
    }

    match /conversionQuota/{quotaId} {
      allow read: if isAdmin();
    }

    match /toolQuota/{quotaId} {
      allow read: if isAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isCollaborator(noteData) {
      return isSignedIn()
        && request.auth.token.email != null
        && ('sharedWith' in noteData)
        && (request.auth.token.email.lower() in noteData.sharedWith);
    }
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'ddooxthawsng@gmail.com')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
  }
}
